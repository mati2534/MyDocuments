<?xml version="1.0" encoding="UTF-8" ?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--Przeszuka wskazany pakiet i automatycznie utworzy beany dla klas oznaczonych adnotacjami Springa.-->
    <context:component-scan base-package="pl.Documents.MyDocuments.annotated"/>

    <bean id="webType" class="pl.Documents.MyDocuments.model.Type">
        <property name="name" value="WEB"/>
        <property name="desc" value="Łącze sieciowe"/>
        <property name="extension" value=".url"/>
    </bean>
</beans>